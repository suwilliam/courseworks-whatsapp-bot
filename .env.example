# CourseWorks (Canvas) — personal access token. Keep this file private.
CANVAS_API_TOKEN=your-courseworks-token
CANVAS_BASE_URL=https://courseworks2.columbia.edu

GEMINI_API_KEY=your-gemini-key
# Optional: limit to specific course IDs (comma-separated). Empty = all active courses.
COURSE_IDS=
# Optional: only respond in these WhatsApp groups (exact names, comma-separated).
ALLOWED_GROUPS=
BOT_TRIGGERS=!exie,@exie,!cw
ANSWER_DMS=false
TIMEZONE=America/New_York

# Paid fallback (Vertex AI, billed to Google Cloud) — used only when free Gemini is busy/out of quota.
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=global
VERTEX_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
VERTEX_DAILY_CAP=20
